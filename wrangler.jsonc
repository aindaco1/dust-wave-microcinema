{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dust-wave-microcinema",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-07",
  "workers_dev": true,
  "assets": {
    "directory": "dist/public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "vars": {
    "SITE_BASE": "https://dustwavemicrocinema.com",
    "APP_MODE": "production",
    "ADMIN_EMAILS": "alonso@dustwave.xyz",
    "LOGIN_FROM": "microcinema@digest.dustwave.xyz",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dust-wave-microcinema",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "dust-wave-microcinema-images" },
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["microcinema@digest.dustwave.xyz"],
    },
  ],
  "triggers": { "crons": ["17 9 * * *"] },
}
